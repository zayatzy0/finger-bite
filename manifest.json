{
  "manifest_version": 3,
  "name": "Fingerprint Detector",
  "version": "0.1",
  "description": "Detects and controls browser fingerprinting",
  "permissions": ["storage", "activeTab"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}